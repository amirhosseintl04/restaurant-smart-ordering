# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.
# All variables are placeholders. Services read only the variables they need.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL 16 (one server, one database and one user per service; SAD 8.1)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me

# Per-service database passwords, used by deploy/postgres/init when the data volume is first
# initialised. Keep each one identical to the password inside the matching <SVC>_DB_URL below
# (URL-encode special characters there). Changing one later does not alter an existing role.
IDENTITY_DB_PASSWORD=change-me
RESTAURANT_DB_PASSWORD=change-me
CATALOG_DB_PASSWORD=change-me
CONVERSATION_DB_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
ANALYTICS_DB_PASSWORD=change-me

# Passed to each service container as DATABASE_URL (deploy/docker-compose.yml).
IDENTITY_DB_URL=postgresql+asyncpg://identity:change-me@postgres:5432/identity_db
RESTAURANT_DB_URL=postgresql+asyncpg://restaurant:change-me@postgres:5432/restaurant_db
CATALOG_DB_URL=postgresql+asyncpg://catalog:change-me@postgres:5432/catalog_db
CONVERSATION_DB_URL=postgresql+asyncpg://conversation:change-me@postgres:5432/conversation_db
ORDER_DB_URL=postgresql+asyncpg://order:change-me@postgres:5432/order_db
NOTIFICATION_DB_URL=postgresql+asyncpg://notification:change-me@postgres:5432/notification_db
ANALYTICS_DB_URL=postgresql+asyncpg://analytics:change-me@postgres:5432/analytics_db

# RabbitMQ 3.13 (SAD 7.3)
RABBITMQ_URL=amqp://app:change-me@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=change-me
EVENTS_EXCHANGE=domain.events

# Kong Gateway, DB-less mode (SAD 12.1). The proxy is the only host-published port, bound to
# 127.0.0.1; the admin API listens on the container loopback only.
KONG_PROXY_PORT=8000

# JWT (RS256; paths to key files, never the key material itself; SAD 13.1)
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ACCESS_TOKEN_MINUTES=15

# LLM and embeddings (OpenAI-compatible API behind an abstraction layer; SAD 9.7)
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
EMBEDDING_MODEL=replace-me
LLM_TIMEOUT_SECONDS=8

# Bale bot (SAD 12.1, 13.1)
BALE_BOT_TOKEN=replace-me
BALE_WEBHOOK_SECRET=replace-me
