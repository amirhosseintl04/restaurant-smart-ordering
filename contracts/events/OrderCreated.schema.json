{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderCreated",
  "description": "An order was placed with status CREATED. Notification alerts staff, Analytics records the sale (SAD 7.2, 10.1). Routing key: order.created.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "OrderCreated"
    },
    "event_version": {
      "const": 1
    },
    "producer": {
      "const": "order-service"
    },
    "data": {
      "type": "object",
      "required": [
        "order_id",
        "customer_ref",
        "items",
        "total"
      ],
      "properties": {
        "order_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "customer_ref": {
          "$ref": "common.schema.json#/$defs/customer_ref"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/order_line"
          }
        },
        "total": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "source": {
          "description": "Where the order came from, e.g. conversation.",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    }
  }
}
